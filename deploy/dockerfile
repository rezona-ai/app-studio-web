# 自定义 server.ts（ws WebSocket）不能走 next standalone，
# 运行时需保留完整 node_modules（含 tsx）+ .next 产物，用 tsx 直接跑 server.ts。
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm PATH=$PNPM_HOME:$PATH
RUN corepack enable

# --- 依赖层（含 dev 依赖：build 需要、运行时 tsx 也需要）---
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# --- 构建层：next build ---
FROM base AS build
WORKDIR /app
# NEXT_PUBLIC_* 必须在构建期烘进客户端 bundle（Koubou WS 由 PGC 基址派生，无需单独变量）
ARG NEXT_PUBLIC_BASE_PATH=""
ARG NEXT_PUBLIC_PGC_BASE_URL=""
ARG NEXT_PUBLIC_APP_ENV=""
ENV NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH} \
    NEXT_PUBLIC_PGC_BASE_URL=${NEXT_PUBLIC_PGC_BASE_URL} \
    NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV}
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm build

# --- 运行层 ---
FROM base AS runner
WORKDIR /app
# server.ts 运行时也要按同一前缀匹配 WS 升级路径
ARG NEXT_PUBLIC_BASE_PATH=""
ENV NODE_ENV=production PORT=8080 NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}
COPY --from=deps  /app/node_modules ./node_modules
COPY --from=build /app/.next        ./.next
COPY --from=build /app/public       ./public
COPY --from=build /app/server.ts /app/next.config.ts /app/tsconfig.json /app/package.json ./
COPY --from=build /app/src          ./src
EXPOSE 8080
# 直接跑 tsx 二进制，不用 `pnpm exec`：后者会触发 pnpm 依赖状态检查
# （重下 corepack + install），并因构建脚本被忽略而 exit 1，导致容器崩溃。
CMD ["/app/node_modules/.bin/tsx", "server.ts"]
