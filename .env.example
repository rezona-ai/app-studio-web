PORT=3000

# pgc-server 对接(服务端;Koubou 与 PGC 同址,裸域名。服务前缀 PGC=/game/pgcserver、Koubou=/game/koubou 在代码层拼)
PGC_BASE_URL=https://devlab.rezona.ai
# 前端用:媒体直连 + 由其派生 Koubou WS 地址(https→wss)
NEXT_PUBLIC_PGC_BASE_URL=https://devlab.rezona.ai

# 仅本地调试 Koubou:两项都设时,Koubou 流量(BFF 代理 + 浏览器 WS)直连本地服务(挂根路径,
# 不拼 /game/koubou 前缀);PGC 仍走上面的远端。不设/空串走 PGC 基址派生。
# KOUBOU_BASE_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_KOUBOU_BASE_URL=http://127.0.0.1:8000
# 本地 koubou 的版本快照根目录({data_root}/{user}/workspaces):本地模式下游戏预览
# 改走本服务 /api/local-preview 直读磁盘(dev PGC bucket 没有本地生成的 dist)
# LOCAL_GAME_ROOT=/path/to/koubou-agent-py/users/local-user/workspaces

# 仅本地开发:注入一条 dev session cookie。BFF 把它转发给 pgc/koubou 做 cookie 制鉴权
# (生产由 *.rezona.ai 父页面自动下发 cookie,部署不设此项)。形如 DEV_COOKIE=session=<值>
DEV_COOKIE=

# GA4 环境:全环境共用 property G-HXYXWKDJLQ,事件的 env 参数是区分环境的唯一手段。
# production→env=prod(不开 debug) / stage→stage / develop→dev / 未设→local,均带 debug_mode。
# 部署由 CI 透传 GitHub environment 原名,本地留空即可(自测在 GA4 DebugView 按 env=local 过滤)。
NEXT_PUBLIC_APP_ENV=
